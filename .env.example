# =============================================================================
# Environment Variables — copy to .env.local and fill in your values
# =============================================================================

# Site URL (used for metadata, OG tags, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://yoursite.com

# Analytics — Plausible domain (leave empty or remove to disable analytics script)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yoursite.com

# Email Forwarding (Postmark)
# Server token from your Postmark account
POSTMARK_SERVER_TOKEN=your-postmark-server-token

# Webhook secret — set to a random string, then configure the same value
# as a query parameter in your Postmark inbound webhook URL:
#   https://yoursite.com/api/inbound?secret=YOUR_SECRET_HERE
INBOUND_WEBHOOK_SECRET=generate-a-random-string-here

# IMPORTANT: Vercel env vars may have trailing whitespace that causes 401s.
# The API route applies .trim() automatically, but double-check values in
# the Vercel dashboard if authentication fails.
